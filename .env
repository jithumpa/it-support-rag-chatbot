# ====================================================
# IT Support Chatbot - Environment Configuration
# ====================================================
# 
# IMPORTANT: This file contains sensitive API keys.
# - Never commit this file to public repositories
# - Add .env to .gitignore
# - Keep your API keys confidential
#
# ====================================================
# REQUIRED CONFIGURATION
# ====================================================

# Anthropic API Key (Required - for Claude AI)
# Get your key at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-

# ====================================================
# OPTIONAL: Advanced RAG Configuration
# ====================================================
# Leave empty to use fallback keyword-based search

# VoyageAI API Key (Optional - for embeddings)
# Get your key at: https://www.voyageai.com
VOYAGE_API_KEY=

# Pinecone Configuration (Optional - for vector database)
# Get your key at: https://www.pinecone.io
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west-1
PINECONE_INDEX_NAME=it-support-kb

# ====================================================
# OPTIONAL: Web Search Configuration
# ====================================================

# Web Search API Key (Optional)
# Example: SerpAPI (https://serpapi.com)
# WEB_SEARCH_API_KEY=

# ====================================================
# APPLICATION SETTINGS
# ====================================================

# Streamlit Settings
STREAMLIT_PORT=8501
STREAMLIT_THEME=light

# MCP Server Settings  
MCP_SERVER_PORT=8000
MCP_SERVER_HOST=0.0.0.0

# ====================================================
# SETUP INSTRUCTIONS
# ====================================================
#
# 1. Get Anthropic API Key:
#    - Visit https://console.anthropic.com
#    - Create API key
#    - Paste after ANTHROPIC_API_KEY=
#
# 2. (Optional) Get VoyageAI API Key:
#    - Visit https://www.voyageai.com
#    - Sign up and create API key
#    - Paste after VOYAGE_API_KEY=
#
# 3. (Optional) Get Pinecone API Key:
#    - Visit https://www.pinecone.io
#    - Create account and project
#    - Paste API key and environment
#
# 4. Test Configuration:
#    python -c "from dotenv import load_dotenv; import os; load_dotenv(); print('ANTHROPIC_API_KEY:', 'Set ✓' if os.getenv('ANTHROPIC_API_KEY') else 'Missing ✗')"
#
# ====================================================
